{
  "framework": "vite",
  "buildCommand": "npx vite build",
  "devCommand": "vite",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/contact", "destination": "/connect-us", "permanent": true },
    { "source": "/contact-us", "destination": "/connect-us", "permanent": true },
    { "source": "/blog/:slug/", "destination": "/blog/:slug", "permanent": true },
    { "source": "/locations/:slug/", "destination": "/locations/:slug", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/|robots\\.txt|sitemap\\.xml|favicon|logo|mbx-logo|icons\\.svg|WhatsApp).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
