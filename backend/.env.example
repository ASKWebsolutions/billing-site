PORT=5000

# Copy this file to .env and fill in real values. Never commit .env.
# Create the database user in MongoDB Atlas -> Database Access, and scope it to
# the single database this app uses (readWrite is enough).
MONGODB_URI=mongodb://<username>:<password>@<cluster-host>?ssl=true&replicaSet=<replica-set>&authSource=admin&appName=<app-name>

# Long random string. Rotating it logs every admin out.
JWT_SECRET=replace_with_a_long_random_string

# Credentials for the admin dashboard (/admin).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Only needed for legacy gallery images that were uploaded rather than linked.
# The gallery now stores image URLs, so these can stay empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
